<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <!-- Custom Remotes (avoid ROM conflicts) -->
    <remote name="marble-gh" fetch="https://github.com" />
    <remote name="marble-gl" fetch="https://gitlab.com" />

    <!-- Device Trees -->
    <project
        path="device/xiaomi/marble"
        name="Marble-trees/android_device_xiaomi_marble"
        remote="marble-gh"
        clone-depth="1" />

    <project
        path="device/xiaomi/sm8450-common"
        name="Marble-trees/android_device_xiaomi_sm8450-common"
        remote="marble-gh"
        clone-depth="1" />

    <project
        path="device/xiaomi/miuicamera-marble"
        name="Chaitanyakm/device_xiaomi_miuicamera-marble"
        remote="marble-gh"
        clone-depth="1" />

    <!-- Vendor -->
    <project
        path="vendor/xiaomi/marble"
        name="Marble-trees/proprietary_vendor_xiaomi_marble"
        remote="marble-gh"
        clone-depth="1" />

    <project
        path="vendor/xiaomi/sm8450-common"
        name="Marble-trees/proprietary_vendor_xiaomi_sm8450-common"
        remote="marble-gh"
        clone-depth="1" />

    <project
        path="vendor/xiaomi/miuicamera-marble"
        name="Chaitanyakm/vendor_xiaomi_miuicamera-marble"
        remote="marble-gl"
        clone-depth="1" />

    <!-- Kernel -->
    <project
        path="kernel/xiaomi/sm8450"
        name="LineageOS/android_kernel_xiaomi_sm8450"
        remote="marble-gh"
        clone-depth="1" />

    <project
        path="kernel/xiaomi/sm8450-modules"
        name="LineageOS/android_kernel_xiaomi_sm8450-modules"
        remote="marble-gh"
        clone-depth="1" />

    <project
        path="kernel/xiaomi/sm8450-devicetrees"
        name="LineageOS/android_kernel_xiaomi_sm8450-devicetrees"
        remote="marble-gh"
        clone-depth="1" />

    <!-- Hardware -->
    <project
        path="hardware/xiaomi"
        name="LineageOS/android_hardware_xiaomi"
        remote="marble-gh"
        clone-depth="1" />

    <project
        path="hardware/dolby"
        name="Marble-trees/android_hardware_dolby"
        remote="marble-gh"
        clone-depth="1" />

    <project path="packages/apps/GameBar"
             name="Marble-trees/packages_apps_GameBar"
             remote="marble-gh"
             revision="main" />

</manifest>
